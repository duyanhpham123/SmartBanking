# Sao chép thành .env rồi chỉnh trước khi chạy docker compose

# --- docker compose up (MySQL riêng trong Docker, DB trống lúc đầu) ---
MYSQL_ROOT_PASSWORD=smartbanking
MYSQL_PORT=3307
API_PORT=8081

# --- docker compose -f docker-compose.host-db.yml up (dùng MySQL trên máy) ---
HOST_MYSQL_HOST=host.docker.internal
HOST_MYSQL_PORT=3306
HOST_MYSQL_USER=root
HOST_MYSQL_PASSWORD=your_local_mysql_password

JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
APP_FE_BASE_URL=http://localhost:5500
